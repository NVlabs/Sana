{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery.schema.json",
  "title": "Workflow delivery frontier",
  "type": "object",
  "required": [
    "schema_version",
    "delivery_kind",
    "workflow_uid",
    "experiment_uid",
    "model_id",
    "component",
    "status",
    "baseline",
    "implementation_package",
    "frontier_points",
    "pareto_assessment"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "delivery_kind": {"enum": ["component_frontier", "integrated_frontier"]},
    "workflow_uid": {"type": "string", "minLength": 1},
    "experiment_uid": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "component": {"enum": ["kernel", "cache", "pisa", "integrator"]},
    "status": {"const": "complete"},
    "baseline": {
      "type": "object",
      "required": ["lock_path", "lock_sha256", "workload_id"],
      "properties": {
        "lock_path": {"type": "string", "minLength": 1},
        "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "workload_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "implementation_package": {
      "type": "object",
      "required": ["files", "build_smoke"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": true
          }
        },
        "build_smoke": {
          "type": "object",
          "required": ["status"],
          "properties": {"status": {"enum": ["passed", "not_required"]}},
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "frontier_points": {
      "type": "array",
      "items": {"$ref": "#/$defs/frontier_point"}
    },
    "pareto_assessment": {
      "type": "object",
      "required": ["status", "objective"],
      "properties": {
        "status": {"const": "nondominated"},
        "objective": {"const": "maximize_quality_subject_to_measured_compute_budget"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"component": {"const": "kernel"}}},
      "then": {
        "properties": {
          "frontier_points": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/frontier_point"},
                {
                  "properties": {
                    "tier": {"const": "exact_fastest"},
                    "quality": {
                      "type": "object",
                      "required": ["lossless"],
                      "properties": {"lossless": {"const": true}}
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "frontier_points": {"minItems": 3, "maxItems": 3}
        }
      }
    }
  ],
  "$defs": {
    "frontier_point": {
      "type": "object",
      "required": [
        "tier",
        "candidate_id",
        "run_dir",
        "implementation_manifest",
        "activation",
        "compute_budget",
        "performance",
        "quality",
        "runtime_evidence",
        "artifacts"
      ],
      "properties": {
        "tier": {"enum": ["exact_fastest", "conservative", "balanced", "aggressive"]},
        "candidate_id": {"type": "string", "minLength": 1},
        "run_dir": {"type": "string", "minLength": 1},
        "implementation_manifest": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": true
        },
        "activation": {"type": "object"},
        "compute_budget": {"type": "object"},
        "performance": {
          "type": "object",
          "required": ["timing_scope", "baseline_total_s", "candidate_total_s", "speedup"],
          "properties": {
            "timing_scope": {"type": "string", "minLength": 1},
            "baseline_total_s": {"type": "number", "exclusiveMinimum": 0},
            "candidate_total_s": {"type": "number", "exclusiveMinimum": 0},
            "speedup": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": true
        },
        "quality": {
          "type": "object",
          "required": ["review_status", "candidate_relation", "max_artifact_severity"],
          "properties": {
            "review_status": {"const": "complete"},
            "candidate_relation": {"type": "string", "minLength": 1},
            "max_artifact_severity": {"enum": ["none", "low", "medium", "high", "critical"]},
            "lossless": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "runtime_evidence": {"type": "object"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
