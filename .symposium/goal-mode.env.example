# Project-local interactive goal-mode launcher configuration.
#
# Copy this file to .symposium/goal-mode.env for local machine settings.
# Keep machine-specific launcher paths out of committed files.

export PATH="$HOME/.nvm/versions/node/v22.22.2/bin:$HOME/.local/bin:$HOME/bin:$HOME/.codex/bin:$PATH"

# Claude Code is useful for Symposium interview/refinement sessions.
export CLAUDE_GOAL_COMMAND="$HOME/.local/bin/claude"

# Symposium delegates Codex sessions to codex_auto_run.py. The launcher resolves
# CODEX_AUTORUN first, then ~/codex_auto_run.py, then
# ~/code/codex_exec/codex_auto_run.py.
export CODEX_AUTORUN="$HOME/codex_auto_run.py"
export CODEX_AUTORUN_MODEL="gpt-5.6-sol"
export CODEX_AUTORUN_SANDBOX="workspace-write"

# Optional explicit Codex binary. Only the first token is used; autorun owns
# working-directory, model, approval, sandbox, and no-alt-screen arguments.
# export CODEX_GOAL_COMMAND="$HOME/.local/bin/codex"
