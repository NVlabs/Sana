{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integrator_ia/integration_delivery.schema.json",
  "title": "Integrated Sana Three-Recipe Delivery",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_uid",
    "experiment_uid",
    "source_lock",
    "integrated_manifest",
    "implementation_files",
    "timing_contract",
    "recipes"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "workflow_uid": {"const": "integrator_ia"},
    "experiment_uid": {"type": "string", "minLength": 1},
    "source_lock": {"$ref": "#/$defs/hashedPath"},
    "integrated_manifest": {"$ref": "#/$defs/hashedPath"},
    "implementation_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hashedPath"}
    },
    "timing_contract": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"const": "warm_single_sample_text_encoder_through_vae_decode"}
      }
    },
    "recipes": {
      "type": "object",
      "required": ["conservative", "balanced", "aggressive"],
      "properties": {
        "conservative": {"$ref": "#/$defs/recipe"},
        "balanced": {"$ref": "#/$defs/recipe"},
        "aggressive": {"$ref": "#/$defs/recipe"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hashedPath": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "kernelComponent": {
      "type": "object",
      "required": ["enabled", "candidate_ids", "dispatches", "fallbacks"],
      "properties": {
        "enabled": {"type": "boolean"},
        "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dispatches": {"type": "integer", "minimum": 0},
        "fallbacks": {"const": 0}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"properties": {"dispatches": {"minimum": 1}}},
        "else": {"properties": {"dispatches": {"const": 0}}}
      }]
    },
    "pisaComponent": {
      "type": "object",
      "required": ["enabled", "candidate_id", "dispatches", "fallbacks"],
      "properties": {
        "enabled": {"type": "boolean"},
        "candidate_id": {"type": "string", "minLength": 1},
        "dispatches": {"type": "integer", "minimum": 0},
        "fallbacks": {"const": 0}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"properties": {"dispatches": {"minimum": 1}}},
        "else": {"properties": {"dispatches": {"const": 0}}}
      }]
    },
    "cacheComponent": {
      "type": "object",
      "required": ["enabled", "candidate_id", "calls", "hits"],
      "properties": {
        "enabled": {"type": "boolean"},
        "candidate_id": {"type": "string", "minLength": 1},
        "calls": {"type": "integer", "minimum": 0},
        "hits": {"type": "integer", "minimum": 0}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}},
        "then": {"properties": {"calls": {"const": 250}, "hits": {"minimum": 1}}},
        "else": {"properties": {"calls": {"const": 0}, "hits": {"const": 0}}}
      }]
    },
    "performance": {
      "type": "object",
      "required": ["baseline_sample_total_s", "candidate_sample_total_s", "speedup"],
      "properties": {
        "baseline_sample_total_s": {"type": "number", "exclusiveMinimum": 0},
        "candidate_sample_total_s": {"type": "number", "exclusiveMinimum": 0},
        "speedup": {"type": "number", "exclusiveMinimum": 1}
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "candidate_id", "activation_env", "components", "settings", "run",
        "performance", "quality"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "activation_env": {"type": "object", "minProperties": 1},
        "components": {
          "type": "object",
          "required": ["kernel", "pisa", "cache"],
          "properties": {
            "kernel": {"$ref": "#/$defs/kernelComponent"},
            "pisa": {"$ref": "#/$defs/pisaComponent"},
            "cache": {"$ref": "#/$defs/cacheComponent"}
          },
          "additionalProperties": false
        },
        "settings": {"type": "object"},
        "run": {
          "type": "object",
          "required": ["run_dir", "benchmark", "integration_stats"],
          "properties": {
            "run_dir": {"type": "string", "minLength": 1},
            "benchmark": {"type": "string", "minLength": 1},
            "integration_stats": {"type": "string", "minLength": 1}
          }
        },
        "performance": {"$ref": "#/$defs/performance"},
        "quality": {
          "type": "object",
          "required": [
            "tier", "assess_verdict", "codex_visual_overall",
            "max_artifact_severity", "lpips_max"
          ],
          "properties": {
            "tier": {"enum": ["conservative", "balanced", "aggressive"]},
            "assess_verdict": {"type": "string", "minLength": 1},
            "codex_visual_overall": {"const": "pass"},
            "max_artifact_severity": {"enum": ["none", "low", "medium"]},
            "lpips_max": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
