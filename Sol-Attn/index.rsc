ildren":"2.02×"}],["$","div",null,{"className":"latency-bar latency-bar-sol","children":[["$","span",null,{"children":"Sol-Attn"}],["$","i",null,{"children":["$","b",null,{"style":{"width":"49.5%"}}]}]]}]]}]]}],["$","div","Hunyuan 1.5",{"className":"latency-model","children":[["$","div",null,{"className":"latency-model-heading","children":["$","span",null,{"children":"Hunyuan 1.5"}]}],["$","div",null,{"className":"latency-bars","children":[["$","div",null,{"className":"latency-bar latency-bar-dense","children":[["$","span",null,{"children":"Dense"}],["$","i",null,{"children":["$","b",null,{}]}]]}],["$","em",null,{"className":"latency-speedup","children":"2.12×"}],["$","div",null,{"className":"latency-bar latency-bar-sol","children":[["$","span",null,{"children":"Sol-Attn"}],["$","i",null,{"children":["$","b",null,{"style":{"width":"47.2%"}}]}]]}]]}]]}],["$","div","LTX 2.3",{"className":"latency-model","children":[["$","div",null,{"className":"latency-model-heading","children":["$","span",null,{"children":"LTX 2.3"}]}],["$","div",null,{"className":"latency-bars","children":[["$","div",null,{"className":"latency-bar latency-bar-dense","children":[["$","span",null,{"children":"Dense"}],["$","i",null,{"children":["$","b",null,{}]}]]}],["$","em",null,{"className":"latency-speedup","children":"1.90×"}],["$","div",null,{"className":"latency-bar latency-bar-sol","children":[["$","span",null,{"children":"Sol-Attn"}],["$","i",null,{"children":["$","b",null,{"style":{"width":"52.6%"}}]}]]}]]}]]}],["$","div","Bernini",{"className":"latency-model","children":[["$","div",null,{"className":"latency-model-heading","children":["$","span",null,{"children":"Bernini"}]}],["$","div",null,{"className":"latency-bars","children":[["$","div",null,{"className":"latency-bar latency-bar-dense","children":[["$","span",null,{"children":"Dense"}],["$","i",null,{"children":["$","b",null,{}]}]]}],["$","em",null,{"className":"latency-speedup","children":"2.34×"}],["$","div",null,{"className":"latency-bar latency-bar-sol","children":[["$","span",null,{"children":"Sol-Attn"}],["$","i",null,{"children":["$","b",null,{"style":{"width":"42.7%"}}]}]]}]]}]]}]]}]}]]}]]}],["$","section",null,{"className":"abstract-section","id":"abstract","children":["$","div",null,{"className":"abstract-inner section","children":[["$","div",null,{"className":"abstract-title","children":[["$","p",null,{"className":"eyebrow","children":"Paper overview"}],["$","h2",null,{"children":"Abstract"}],["$","p",null,{"children":"Training-free on-the-fly attention sparsification for efficient visual generation"}]]}],["$","div",null,{"className":"abstract-copy","children":[["$","p",null,{"children":["Training-free dynamic sparse attention accelerates pretrained visual generators, but existing methods rely on costly offline routing and discard every unselected block. ","$L7"," ","unifies query-dependent threshold routing, sparse computation, and approximate correction within a single online-softmax pass. It selects blocks on chip without materializing a proxy map, then reuses below-threshold score columns to retain the long-tail contribution of skipped blocks."]}],"$L8"]}]]}]}],"$L9","$La"]}]
