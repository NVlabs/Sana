{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integrator_ia/source_selection.schema.json",
  "title": "Integrator IA Source Inventory",
  "type": "object",
  "required": ["schema_version", "workflow_uid", "experiment_uid", "status", "sources", "issues"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_uid": {"const": "integrator_ia"},
    "experiment_uid": {"type": "string"},
    "status": {"enum": ["ready", "blocked"]},
    "issues": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "object",
      "required": ["kernel", "pisa", "cache"],
      "properties": {
        "kernel": {"$ref": "#/$defs/source"},
        "pisa": {"$ref": "#/$defs/source"},
        "cache": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["role", "path", "sha256", "size", "snapshot_path", "snapshot_sha256"],
      "properties": {
        "role": {"type": "string"},
        "path": {"type": "string"},
        "relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "snapshot_path": {"type": "string"},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "root", "snapshot_root", "selection", "artifacts", "implementation_files"],
      "properties": {
        "kind": {"enum": ["kernel", "pisa", "cache"]},
        "root": {"type": "string"},
        "snapshot_root": {"type": "string"},
        "selection": {"type": "object"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "implementation_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  }
}
